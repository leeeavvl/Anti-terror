# Пример: имя переменной окружения указывается в конфиге источника (auth_env_var),
# само значение токена никогда не хранится в базе данных.

# Токен для встроенного VK-коннектора (connector_type="vk").
# Получается на vk.com/dev — токен пользователя/сообщества или сервисный токен
# с доступом к стене (wall). По умолчанию форма добавления источника ожидает
# именно имя VK_TOKEN, но можно указать любое другое.
# VK_TOKEN=your-real-vk-access-token

# Токен для встроенного Telegram-коннектора (connector_type="telegram").
# Токен бота выдаётся @BotFather; бот должен быть добавлен администратором
# в целевой публичный канал. По умолчанию форма ожидает имя TG_BOT_TOKEN.
# TG_BOT_TOKEN=your-real-telegram-bot-token

# Пример для generic_api-источника с произвольным именем переменной:
# PLATFORM_TOKEN=your-real-api-token-here

# POLL_INTERVAL_SECONDS=20
